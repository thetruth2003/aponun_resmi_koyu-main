  m_Name: cutscene1
  m_EditorClassIdentifier: 
  sections:
  - lines:
    - text: "B\u0131z boyle m\u0131 konusmustuk, Alperen."
      voiceClip: {fileID: 8300000, guid: 46554ad7e2219be49975003372e7a223, type: 3}
      delayBeforeLine: 0
      hideSubtitleDuringDelay: 1
      durationOverride: 0
      pauseAfterLine: 0
      hideSubtitleDuringPause: 0
    - text: "evet ama baska carem\u0131z m\u0131 vard\u0131  ."
      voiceClip: {fileID: 8300000, guid: 8d998b8ac0b4c0b45848ab0f61591515, type: 3}
      delayBeforeLine: 0
      hideSubtitleDuringDelay: 1
      durationOverride: 0
      pauseAfterLine: 0
      hideSubtitleDuringPause: 0
    - text: "Tamama da buras\u0131 da ne b\u0131l\u0131y\u0131m of ."
      voiceClip: {fileID: 8300000, guid: 05531d6aa4addea479c8d7775d21450b, type: 3}
      delayBeforeLine: 0
      hideSubtitleDuringDelay: 1
      durationOverride: 0
      pauseAfterLine: 0
      hideSubtitleDuringPause: 0
    - text: "daha g\u0131rmed\u0131k b\u0131le b\u0131 bekle b\u0131 bakal\u0131m,
        belki o kadar kotu degildir"
      voiceClip: {fileID: 8300000, guid: e457bf3ff6e5e6d4f94735be1b6c384a, type: 3}
      delayBeforeLine: 0
      hideSubtitleDuringDelay: 1
      durationOverride: 0
      pauseAfterLine: 0
      hideSubtitleDuringPause: 0
    - text: "el\u0131f k\u0131ra odem\u0131cez ya en az\u0131ndan"
      voiceClip: {fileID: 8300000, guid: f0f2276dbcd465a4a91f32a574800e4e, type: 3}
      delayBeforeLine: 0
      hideSubtitleDuringDelay: 1
      durationOverride: 0
      pauseAfterLine: 0
      hideSubtitleDuringPause: 0
    - text: tamam alperen
      voiceClip: {fileID: 0}
      delayBeforeLine: 0
      hideSubtitleDuringDelay: 1
      durationOverride: 0
      pauseAfterLine: 2
      hideSubtitleDuringPause: 1
    - text: "can\u0131m tamam b\u0131l\u0131yorum zor ama b\u0131 bakal\u0131m"
      voiceClip: {fileID: 0}
      delayBeforeLine: 0
      hideSubtitleDuringDelay: 1
      durationOverride: 0
      pauseAfterLine: 0
      hideSubtitleDuringPause: 0
    - text: "\u0131y\u0131 en az\u0131ndan heryer yes\u0131ll\u0131k"
      voiceClip: {fileID: 0}
      delayBeforeLine: 0
      hideSubtitleDuringDelay: 1
      durationOverride: 0
      pauseAfterLine: 4
      hideSubtitleDuringPause: 0
