  sections:
  - lines:
    - text: "selamuun aleykum ab\u0131 "
      voiceClip: {fileID: 0}
    - text: aleykum selam hocam
      voiceClip: {fileID: 0}
    - text: "abi bi ciftel 2000 mavi alcakt\u0131m bide bi selam veriyim dedim yeni
        tas\u0131nd\u0131k"
      voiceClip: {fileID: 0}
    - text: "sen yen\u0131 gelen arkadass\u0131n duymustum \u0131s\u0131m neyd\u0131
        hocam"
      voiceClip: {fileID: 0}
    - text: alperen abi senin?
      voiceClip: {fileID: 0}
    - text: 'ibrahim kardesim '
      voiceClip: {fileID: 0}
    - text: 'memnun oldum abi '
      voiceClip: {fileID: 0}
    - text: eyvallah ne istemistin kardesim
      voiceClip: {fileID: 0}
    - text: ciftel 2000 abi
      voiceClip: {fileID: 0}
    - text: "o s\u0131k\u0131nt\u0131 hocam onu bulaman burda"
      voiceClip: {fileID: 0}
