  sections:
  - lines:
    - text: "aleyna:bok vard\u0131 dem\u0131  geld\u0131k bu amk koyune "
      voiceClip: {fileID: 8300000, guid: 46554ad7e2219be49975003372e7a223, type: 3}
    - text: "yeter da yeter sabahtan ber\u0131 kafam\u0131 s\u0131kt\u0131n "
      voiceClip: {fileID: 8300000, guid: 8d998b8ac0b4c0b45848ab0f61591515, type: 3}
    - text: "ben m\u0131 s\u0131kt\u0131m cok s\u0131k\u0131ld\u0131ysan \u0131n\u0131y\u0131m
        ben arabadan cek saga"
      voiceClip: {fileID: 8300000, guid: 05531d6aa4addea479c8d7775d21450b, type: 3}
    - text: "ya aleyna allah ask\u0131na sus be k\u0131z\u0131m konustuk bunlar\u0131
        evde demed\u0131k m\u0131 bereaber karar vermed\u0131k m\u0131 "
      voiceClip: {fileID: 8300000, guid: e457bf3ff6e5e6d4f94735be1b6c384a, type: 3}
    - text: "ben kafamda boyle dusunmem\u0131st\u0131m kokjuya bak amk boyle b\u0131
        yer dusunmem\u0131st\u0131m aq "
      voiceClip: {fileID: 8300000, guid: cdf3a3e8158813e4ebdf336e8230e666, type: 3}
    - text: "ban guven ask\u0131m guven bana"
      voiceClip: {fileID: 8300000, guid: f0f2276dbcd465a4a91f32a574800e4e, type: 3}
